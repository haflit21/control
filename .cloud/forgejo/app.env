# Constantes de déploiement du projet, lues par les scripts de .cloud/forgejo/.
APP=control                        # nom du dépôt = nom de l'image
STACK=control                      # stack Portainer
CONTAINER=control                  # conteneur vérifié après déploiement
CHECK_URL=http://192.168.10.6:8080 # doit répondre après déploiement (n'importe quel code HTTP)
HOSTNAME=control.home.arpa         # nom local ajouté dans Pi-hole par Sentinel à la création
IP=192.168.10.6                    # ipv4_address du service dans .cloud/portainer-stack.yml
