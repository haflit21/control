# Copie en .env (jamais commité). Le jeton HA ne sort pas du serveur.
HA_URL=http://192.168.10.242:8123
HA_TOKEN=
# Mode démo : état simulé, pas de HA
# MAISON_DEMO=1
# Jeton de connexion fixe (sinon généré à chaque démarrage et affiché dans les journaux)
# MAISON_TOKEN=
# Réseaux autorisés en plus de serve.allow_from (maison.yaml), séparés par des virgules
# MAISON_ALLOW_FROM=
# MAISON_LISTEN=:8080
# Dossier des photos (pièces, appareils) servi sous /media/ ; défaut : media/ à côté du binaire
# MAISON_MEDIA=media
# Agenda — saisie rapide (agenda.voice dans maison.yaml)
# Clé de l'API Claude (console.anthropic.com), pour comprendre les phrases. Sans elle : formulaire seul.
ANTHROPIC_API_KEY=
# Modèle local compatible OpenAI (provider: openai), si le serveur demande une clé
# LLM_API_KEY=
# Whisper, si le serveur de transcription demande une clé
# STT_API_KEY=
