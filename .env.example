# Les secrets vivent dans .cloud/secrets/secrets.enc.yaml (SOPS, make secrets) ; un .env
# (copie de ce fichier, jamais commité) ne sert qu'à compléter en développement.
HA_URL=http://192.168.10.242:8123
HA_TOKEN=
# Mode démo : état simulé, pas de HA
# CONTROL_DEMO=1
# Jeton de connexion fixe (sinon généré à chaque démarrage et affiché dans les journaux)
# CONTROL_TOKEN=
# Réseaux autorisés en plus de serve.allow_from (control.yaml), séparés par des virgules
# CONTROL_ALLOW_FROM=
# CONTROL_LISTEN=:8080
# Dossier des photos (pièces, appareils) servi sous /media/ ; défaut : media/ à côté du binaire
# CONTROL_MEDIA=media
# Agenda — saisie rapide (agenda.voice dans control.yaml)
# Jeton du client control de claude-gateway (provider: gateway). Sans lui : formulaire seul.
# CLAUDE_GATEWAY_TOKEN=
# Clé de l'API Claude, seulement avec provider: anthropic
# ANTHROPIC_API_KEY=
# Modèle local compatible OpenAI (provider: openai), si le serveur demande une clé
# LLM_API_KEY=
# Whisper, si le serveur de transcription demande une clé
# STT_API_KEY=
