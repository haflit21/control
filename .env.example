# Copie en .env (jamais commité). Le jeton HA ne sort pas du serveur.
HA_URL=http://192.168.10.242:8123
HA_TOKEN=
# Mode démo : état simulé, pas de HA
# MAISON_DEMO=1
# Jeton de connexion fixe (sinon généré à chaque démarrage et affiché dans les journaux)
# MAISON_TOKEN=
# Réseaux autorisés en plus de serve.allow_from (maison.yaml), séparés par des virgules
# MAISON_ALLOW_FROM=
# MAISON_LISTEN=:8080
# Dossier des photos (pièces, appareils) servi sous /media/ ; défaut : media/ à côté du binaire
# MAISON_MEDIA=media
